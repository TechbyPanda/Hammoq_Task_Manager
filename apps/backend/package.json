{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "nodemon --ext ts,json --ignore dist --exec \"tsx --env-file-if-exists=.env index.ts\"",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.3.0",
    "jsonwebtoken": "9.0.3",
    "mongoose": "^9.12.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@repo/typescript-config": "*",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "26.4.1",
    "nodemon": "3.1.14",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
